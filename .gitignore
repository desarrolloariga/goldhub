# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# supabase (CLI local)
/supabase/.branches
/supabase/.temp
/supabase/.env

# artefacto generado por `npm run db:bundle`
/supabase/aplicar.sql

# typescript
*.tsbuildinfo
next-env.d.ts

# Credenciales en claro del alta de equipo: nunca al repositorio.
credenciales*.csv
equipo*.csv
alta-equipo*.sql
